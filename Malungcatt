function UILibrary:CreateSlider(parent, title, min, max, default, rounding, callback)
	local frame = Instance.new("Frame", parent)
	frame.Size = UDim2.new(1, -5, 0, 50)
	frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 5)

	local label = Instance.new("TextLabel", frame)
	label.Text = title
	label.Size = UDim2.new(0.6, 0, 0, 20)
	label.Position = UDim2.new(0, 10, 0, 5)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1,1,1)
	label.Font = Enum.Font.Gotham
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left

	local sliderRail = Instance.new("Frame", frame)
	sliderRail.Size = UDim2.new(0, 140, 0, 4)
	sliderRail.Position = UDim2.new(0, 10, 0, 25)
	sliderRail.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	Instance.new("UICorner", sliderRail).CornerRadius = UDim.new(1, 0)

	local sliderFill = Instance.new("Frame", sliderRail)
	sliderFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

	local sliderDot = Instance.new("Frame", sliderRail)
	sliderDot.Size = UDim2.new(0, 12, 0, 12)
	sliderDot.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	sliderDot.AnchorPoint = Vector2.new(0.5, 0.5)
	sliderDot.Position = UDim2.new(0, 0, 0.5, 0)
	Instance.new("UICorner", sliderDot).CornerRadius = UDim.new(1, 0)

	local valueTextBox = Instance.new("TextBox", frame)
	valueTextBox.Name = "SliderTextbox"
	valueTextBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	valueTextBox.BackgroundTransparency = 0
	valueTextBox.Position = UDim2.new(1, -90, 0, 5)
	valueTextBox.Size = UDim2.new(0, 80, 0, 20)
	valueTextBox.Font = Enum.Font.GothamSemibold
	valueTextBox.TextColor3 = Color3.fromRGB(225, 225, 225)
	valueTextBox.TextSize = 12
	valueTextBox.TextXAlignment = Enum.TextXAlignment.Center
	valueTextBox.ClearTextOnFocus = false
	valueTextBox.ClipsDescendants = true

	local textboxCorner = Instance.new("UICorner", valueTextBox)
	textboxCorner.CornerRadius = UDim.new(0, 5)

	local textboxStroke = Instance.new("UIStroke", valueTextBox)
	textboxStroke.Color = Color3.fromRGB(100, 100, 100)
	textboxStroke.Thickness = 1

	local dragging = false
	local currentValue = default

	local function UpdateSlider(position)
		local sizeScale = math.clamp((position - sliderRail.AbsolutePosition.X) / sliderRail.AbsoluteSize.X, 0, 1)
		currentValue = math.floor((min + ((max - min) * sizeScale)) / rounding + 0.5) * rounding
		currentValue = math.clamp(currentValue, min, max)

		sliderDot.Position = UDim2.new(sizeScale, -6, 0.5, 0)
		sliderFill.Size = UDim2.fromScale(sizeScale, 1)
		valueTextBox.Text = tostring(currentValue)

		if callback then
			callback(currentValue)
		end
	end

	local function SetValueFromTextBox(text)
		local value = tonumber(text)
		if value then
			value = math.clamp(value, min, max)
			currentValue = math.floor(value / rounding + 0.5) * rounding
			local sizeScale = (currentValue - min) / (max - min)

			sliderDot.Position = UDim2.new(sizeScale, -6, 0.5, 0)
			sliderFill.Size = UDim2.fromScale(sizeScale, 1)
			valueTextBox.Text = tostring(currentValue)

			if callback then
				callback(currentValue)
			end
		end
	end

	sliderDot.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)

	sliderDot.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	valueTextBox.FocusLost:Connect(function()
		SetValueFromTextBox(valueTextBox.Text)
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			UpdateSlider(input.Position.X)
		end
	end)

	UpdateSlider(sliderRail.AbsolutePosition.X + (sliderRail.AbsoluteSize.X * ((default - min) / (max - min))))
end

function UILibrary:CreateToggle(parent, text, callback)
	local Frame = Instance.new("TextButton")
	Frame.Parent = parent
	Frame.Size = UDim2.new(1,-5,0,40)
	Frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
	Frame.AutoButtonColor = false
	Frame.Text = ""
	Frame.ClipsDescendants = true

	local Corner = Instance.new("UICorner", Frame)
	Corner.CornerRadius = UDim.new(0,6)

	local Label = Instance.new("TextLabel")
	Label.Parent = Frame
	Label.BackgroundTransparency = 1
	Label.Position = UDim2.new(0,10,0,0)
	Label.Size = UDim2.new(1,-70,1,0)
	Label.Font = Enum.Font.GothamSemibold
	Label.Text = text
	Label.TextColor3 = Color3.fromRGB(255,255,255)
	Label.TextSize = 13
	Label.TextXAlignment = Enum.TextXAlignment.Left

	local ToggleSlider = Instance.new("Frame")
	ToggleSlider.Parent = Frame
	ToggleSlider.Size = UDim2.fromOffset(36,18)
	ToggleSlider.AnchorPoint = Vector2.new(1,0.5)
	ToggleSlider.Position = UDim2.new(1,-12,0.5,0)
	ToggleSlider.BackgroundColor3 = Color3.fromRGB(60,60,60)
	ToggleSlider.BackgroundTransparency = 1

	local SliderCorner = Instance.new("UICorner", ToggleSlider)
	SliderCorner.CornerRadius = UDim.new(1,0)

	local SliderStroke = Instance.new("UIStroke", ToggleSlider)
	SliderStroke.Color = Color3.fromRGB(120,120,120)
	SliderStroke.Thickness = 1.2
	SliderStroke.Transparency = 0.3

	local ToggleCircle = Instance.new("ImageLabel")
	ToggleCircle.Parent = ToggleSlider
	ToggleCircle.BackgroundTransparency = 1
	ToggleCircle.AnchorPoint = Vector2.new(0,0.5)
	ToggleCircle.Position = UDim2.new(0,2,0.5,0)
	ToggleCircle.Size = UDim2.fromOffset(14,14)
	ToggleCircle.Image = "rbxassetid://12266946128"
	ToggleCircle.ImageColor3 = Color3.fromRGB(160,160,160)
	ToggleCircle.ImageTransparency = 0.5

	local enabled = false

	local function SetToggle(state)
		enabled = state

		TweenService:Create(
			ToggleCircle,
			TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{
				Position = UDim2.new(0, enabled and 19 or 2, 0.5, 0),
				ImageColor3 = enabled and Color3.fromRGB(255,255,255) or Color3.fromRGB(160,160,160),
				ImageTransparency = enabled and 0 or 0.5
			}
		):Play()

		TweenService:Create(
			ToggleSlider,
			TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{
				BackgroundTransparency = enabled and 0.45 or 1,
				BackgroundColor3 = enabled and Color3.fromRGB(255,0,0) or Color3.fromRGB(60,60,60)
			}
		):Play()

		TweenService:Create(
			SliderStroke,
			TweenInfo.new(0.25),
			{
				Color = enabled and Color3.fromRGB(255,0,0) or Color3.fromRGB(120,120,120)
			}
		):Play()

		if callback then
			pcall(callback, enabled)
		end
	end

	Frame.MouseButton1Click:Connect(function()
		SetToggle(not enabled)
	end)

	Frame.MouseEnter:Connect(function()
		TweenService:Create(Frame, TweenInfo.new(0.15), {
			BackgroundColor3 = Color3.fromRGB(30,30,30)
		}):Play()
	end)

	Frame.MouseLeave:Connect(function()
		TweenService:Create(Frame, TweenInfo.new(0.15), {
			BackgroundColor3 = Color3.fromRGB(20,20,20)
		}):Play()
	end)

	local ToggleAPI = {}

	function ToggleAPI:SetValue(bool)
		SetToggle(bool)
	end

	function ToggleAPI:GetValue()
		return enabled
	end

	SetToggle(false)

	return ToggleAPI
end

