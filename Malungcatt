function UILibrary:CreateTab(name, iconId)
	local Tab = Instance.new("TextButton", self.Tabs)
	Tab.Size = UDim2.new(1,-10,0,35)
	Tab.BackgroundColor3 = Color3.fromRGB(25,25,25)
	Tab.TextColor3 = Color3.new(1,1,1)
	Tab.Font = Enum.Font.GothamBold
	Tab.TextSize = 0
	Tab.AutoButtonColor = false
	Tab.Name = name
	Instance.new("UICorner", Tab).CornerRadius = UDim.new(0, 5)

	local stroke = Instance.new("UIStroke", Tab)
	stroke.Color = Color3.fromRGB(50,50,50)
	stroke.Thickness = 1

	if iconId then
		local icon = Instance.new("ImageLabel", Tab)
		icon.Image = iconId
		icon.Size = UDim2.new(0, 16, 0, 16)
		icon.Position = UDim2.new(0, 8, 0.5, -8)
		icon.BackgroundTransparency = 1
		icon.ImageColor3 = Color3.fromRGB(200, 200, 200)

		local label = Instance.new("TextLabel", Tab)
		label.Text = name
		label.Size = UDim2.new(1, -35, 1, 0)
		label.Position = UDim2.new(0, 28, 0, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(200, 200, 200)
		label.Font = Enum.Font.GothamSemibold
		label.TextSize = 11
		label.TextXAlignment = Enum.TextXAlignment.Left
	else
		Tab.Text = name
		Tab.TextSize = 13
	end

	local Page = self:CreatePage(name)

	self.TabsList[name] = Tab
	self.PagesList[name] = Page

	Tab.MouseButton1Click:Connect(function()
		for _, p in pairs(self.PagesList) do p.Visible = false end
		for _, t in pairs(self.TabsList) do
			t.BackgroundColor3 = Color3.fromRGB(25,25,25)
			local icon = t:FindFirstChildOfClass("ImageLabel")
			if icon then
				icon.ImageColor3 = Color3.fromRGB(200, 200, 200)
			end
			local label = t:FindFirstChildOfClass("TextLabel")
			if label then
				label.TextColor3 = Color3.fromRGB(200, 200, 200)
			end
		end
		Page.Visible = true
		Tab.BackgroundColor3 = Color3.fromRGB(255,0,0)
		local icon = Tab:FindFirstChildOfClass("ImageLabel")
		if icon then
			icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
		local label = Tab:FindFirstChildOfClass("TextLabel")
		if label then
			label.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end)

	Tab.MouseEnter:Connect(function()
		if Tab.BackgroundColor3 ~= Color3.fromRGB(255,0,0) then
			TweenService:Create(Tab, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40,40,40)}):Play()
		end
	end)

	Tab.MouseLeave:Connect(function()
		if Tab.BackgroundColor3 ~= Color3.fromRGB(255,0,0) then
			TweenService:Create(Tab, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25,25,25)}):Play()
		end
	end)

	return Page
end

