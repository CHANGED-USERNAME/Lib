	layout.Padding = UDim.new(0,4)

	local confirm = Instance.new("TextButton", dropdown)
	confirm.Size = UDim2.new(1,0,0,30)
	confirm.Text = "Confirm"
	confirm.BackgroundColor3 = Color3.fromRGB(255,0,0)
	confirm.TextColor3 = Color3.new(1,1,1)
	confirm.Visible = false
	local cc = Instance.new("UICorner", confirm)
	cc.CornerRadius = UDim.new(0,8)

	local selected
	local selectedItem

	for _,v in ipairs(items) do
		local item = Instance.new("TextButton", dropdown)
		item.Size = UDim2.new(1,0,0,28)
		item.Text = v
		item.BackgroundColor3 = Color3.fromRGB(15,15,15)
		item.TextColor3 = Color3.new(1,1,1)
		Instance.new("UICorner", item).CornerRadius = UDim.new(0, 5)

		item.MouseButton1Click:Connect(function()
			selected = v
			btn.Text = v
			confirm.Visible = true

			if selectedItem and selectedItem ~= item then
				TweenService:Create(selectedItem, TweenInfo.new(0.2), {
					BackgroundColor3 = Color3.fromRGB(15,15,15)
				}):Play()
			end

			selectedItem = item
			TweenService:Create(item, TweenInfo.new(0.2), {
				BackgroundColor3 = Color3.fromRGB(0,120,255)
			}):Play()
		end)
	end

	local isOpen = false

	btn.MouseButton1Click:Connect(function()
		isOpen = not isOpen

		local size = frame.AbsoluteSize
		local targetHeight = (#items * 28) + 35

		if isOpen then
			dropdown.Visible = true
			dropdown.Size = UDim2.new(0,size.X,0,0)
			containerFrame.Size = UDim2.new(1,-5,0,40 + targetHeight + 5)

			TweenService:Create(dropdown, TweenInfo.new(0.25), {
				Size = UDim2.new(1,0,0,targetHeight)
			}):Play()
		else
			local tween = TweenService:Create(dropdown, TweenInfo.new(0.2), {
				Size = UDim2.new(1,0,0,0)
			})
			tween:Play()
			tween.Completed:Connect(function()
				dropdown.Visible = false
				confirm.Visible = false
				containerFrame.Size = UDim2.new(1,-5,0,40)
			end)
		end
	end)

	confirm.MouseButton1Click:Connect(function()
		isOpen = false

		local tween = TweenService:Create(dropdown, TweenInfo.new(0.2), {
			Size = UDim2.new(1,0,0,0)
		})
		tween:Play()

		tween.Completed:Connect(function()
			dropdown.Visible = false
			confirm.Visible = false
			containerFrame.Size = UDim2.new(1,-5,0,40)
		end)

		if callback then
			callback(selected)
		end
	end)
end

function UILibrary:CreateButton(parent, title, callback)
	local frame = Instance.new("TextButton", parent)
	frame.Size = UDim2.new(1, -5, 0, 35)
	frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
	frame.Name = "Button"
	frame.AutoButtonColor = false
	frame.Text = ""
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 5)

	local label = Instance.new("TextLabel", frame)
	label.Text = title
	label.Size = UDim2.new(1, -25, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1,1,1)
	label.Font = Enum.Font.GothamSemibold
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left

	local buttonIcon = Instance.new("ImageLabel", frame)
	buttonIcon.Image = "rbxassetid://10709791437"
	buttonIcon.Size = UDim2.fromOffset(16, 16)
	buttonIcon.AnchorPoint = Vector2.new(1, 0.5)
	buttonIcon.Position = UDim2.new(1, -10, 0.5, 0)
	buttonIcon.BackgroundTransparency = 1
	buttonIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)

	local mouseEnter = false
	frame.MouseEnter:Connect(function()
		mouseEnter = true
		TweenService:Create(frame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35,35,35)}):Play()
	end)

	frame.MouseLeave:Connect(function()
		mouseEnter = false
		TweenService:Create(frame, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20,20,20)}):Play()
	end)

	frame.MouseButton1Click:Connect(function()
		TweenService:Create(frame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50,50,50)}):Play()
		task.wait(0.1)
		TweenService:Create(frame, TweenInfo.new(0.1), {BackgroundColor3 = mouseEnter and Color3.fromRGB(35,35,35) or Color3.fromRGB(20,20,20)}):Play()

		if callback then
			pcall(callback)
		end
	end)
end

function UILibrary:Destroy()
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
	if self.ShowHideGui then
		self.ShowHideGui:Destroy()
	end
	_G.UILibraryLoaded = false
	_G.UILibraryInstance = nil
end

return UILibrary
