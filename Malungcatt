local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

if _G.UILibraryLoaded then
	warn("[UILibrary] Already loaded! Reloading UI...")
	if _G.UILibraryInstance then
		_G.UILibraryInstance:Destroy()
	end
end

_G.UILibraryLoaded = true

local UILibrary = {}
UILibrary.__index = UILibrary

function UILibrary.new(title)
	local self = setmetatable({}, UILibrary)
	
	self.Title = title or "UI LIBRARY"
	self.ScreenGui = Instance.new("ScreenGui")
	self.ScreenGui.Parent = game.CoreGui
	self.ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	
	self.TabsList = {}
	self.PagesList = {}
	self.Pages = nil
	self.IsMinimized = false
	
	self:CreateMainUI()
	self:CreateShowHideButton()
	
	_G.UILibraryInstance = self
	
	Players.PlayerRemoving:Connect(function(player)
		if player == LocalPlayer then
			_G.UILibraryLoaded = false
			_G.UILibraryInstance = nil
		end
	end)
	
	return self
end

function UILibrary:CreateMainUI()
	local Main = Instance.new("Frame", self.ScreenGui)
	Main.Size = UDim2.new(0, 460, 0, 320)
	Main.Position = UDim2.new(0.5, -230, 0.5, -160)
	Main.BackgroundColor3 = Color3.fromRGB(10,10,10)
	Main.Name = "MainFrame"
	Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 8)

	self.Main = Main
	self.MainPosition = Main.Position -- Store original position

	local TitleBar = Instance.new("Frame", Main)
	TitleBar.Size = UDim2.new(1,0,0,35)
	TitleBar.BackgroundTransparency = 1
	TitleBar.Name = "TitleBar"

	local Title = Instance.new("TextLabel", TitleBar)
	Title.Size = UDim2.new(1,0,1,0)
	Title.BackgroundTransparency = 1
	Title.Text = self.Title
	Title.TextColor3 = Color3.fromRGB(255,0,0)
	Title.Font = Enum.Font.GothamBold
	Title.TextSize = 16

	local dragging, dragStart, startPos

	TitleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = Main.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			Main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	local Tabs = Instance.new("ScrollingFrame", Main)
	Tabs.Size = UDim2.new(0,120,1,-45)
	Tabs.Position = UDim2.new(0,5,0,40)
	Tabs.BackgroundColor3 = Color3.fromRGB(15,15,15)
	Tabs.ScrollBarThickness = 3
	Tabs.Name = "TabsFrame"
	Instance.new("UICorner", Tabs).CornerRadius = UDim.new(0, 5)

	local TabLayout = Instance.new("UIListLayout", Tabs)
	TabLayout.Padding = UDim.new(0,5)

	TabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		Tabs.CanvasSize = UDim2.new(0,0,0,TabLayout.AbsoluteContentSize.Y + 10)
	end)

	self.Tabs = Tabs

	local Pages = Instance.new("Folder", Main)
	Pages.Name = "Pages"
	self.Pages = Pages
end

-- NEW: Create Show/Hide Button
function UILibrary:CreateShowHideButton()
	local ShowHideGui = Instance.new("ScreenGui")
	ShowHideGui.Name = "ShowHideButton"
	ShowHideGui.Parent = game.CoreGui
	ShowHideGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	
	self.ShowHideGui = ShowHideGui
	
	local ShowHideButton = Instance.new("TextButton")
	ShowHideButton.Name = "ShowHideButton"
	ShowHideButton.Parent = ShowHideGui
	ShowHideButton.Size = UDim2.new(0, 50, 0, 50)
	ShowHideButton.Position = UDim2.new(0.1, 0, 0.1, 0)
	ShowHideButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	ShowHideButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	ShowHideButton.Font = Enum.Font.GothamBold
	ShowHideButton.TextSize = 12
	ShowHideButton.Text = "SHOW"
	ShowHideButton.AutoButtonColor = false
	ShowHideButton.Visible = false
	
	local corner = Instance.new("UICorner", ShowHideButton)
	corner.CornerRadius = UDim.new(0, 8)
	
	local stroke = Instance.new("UIStroke", ShowHideButton)
	stroke.Color = Color3.fromRGB(150, 0, 0)
	stroke.Thickness = 2
	
	self.ShowHideButton = ShowHideButton
	
	-- Dragging functionality
	local dragging = false
	local dragStart = nil
	local startPos = nil
	
	local function updateDrag(input)
		local delta = input.Position - dragStart
		ShowHideButton.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
	
	ShowHideButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = ShowHideButton.Position
			
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateDrag(input)
		end
	end)
	
	ShowHideButton.MouseEnter:Connect(function()
		TweenService:Create(ShowHideButton, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(200, 0, 0)
		}):Play()
	end)
	
	ShowHideButton.MouseLeave:Connect(function()
		TweenService:Create(ShowHideButton, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		}):Play()
	end)
	
	ShowHideButton.MouseButton1Click:Connect(function()
		self:ToggleWindow()
	end)
end

-- NEW: Toggle Window Visibility
function UILibrary:ToggleWindow()
	if self.IsMinimized then
		-- Show window
		self.IsMinimized = false
		self.Main.Visible = true
		self.ShowHideButton.Visible = false
		self.ShowHideButton.Text = "SHOW"
		
		-- Animate window back to original position
		TweenService:Create(
			self.Main,
			TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{Position = self.MainPosition}
		):Play()
	else
		-- Hide window
		self.IsMinimized = true
		self.MainPosition = self.Main.Position -- Save current position
		self.ShowHideButton.Visible = true
		self.ShowHideButton.Text = "SHOW"
		
		-- Animate window off-screen
		local viewportSize = self.ScreenGui.AbsoluteSize
		TweenService:Create(
			self.Main,
			TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
			{Position = UDim2.new(0.5, -230, 1, 50)} -- Move down off-screen
		):Play()
		
		-- Hide after animation
		task.wait(0.4)
		if self.IsMinimized then
			self.Main.Visible = false
		end
	end
end

