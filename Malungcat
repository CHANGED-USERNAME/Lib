-- ===== CREATE SLIDER =====
function UILibrary:CreateSlider(parent, title, min, max, default, rounding, callback)
	local frame = Instance.new("Frame", parent)
	frame.Size = UDim2.new(1, -5, 0, 50)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	
	local frameCorner = Instance.new("UICorner", frame)
	frameCorner.CornerRadius = UDim.new(0, 8)

	local stroke = Instance.new("UIStroke", frame)
	stroke.Color = Color3.fromRGB(255, 0, 0)

	local label = Instance.new("TextLabel", frame)
	label.Text = title
	label.Size = UDim2.new(0.6, 0, 0, 20)
	label.Position = UDim2.new(0, 10, 0, 5)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.Gotham
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left

	local sliderRail = Instance.new("Frame", frame)
	sliderRail.Size = UDim2.new(0, 140, 0, 4)
	sliderRail.Position = UDim2.new(0, 10, 0, 25)
	sliderRail.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	
	local railCorner = Instance.new("UICorner", sliderRail)
	railCorner.CornerRadius = UDim.new(1, 0)

	local sliderFill = Instance.new("Frame", sliderRail)
	sliderFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	
	local fillCorner = Instance.new("UICorner", sliderFill)
	fillCorner.CornerRadius = UDim.new(1, 0)

	local sliderDot = Instance.new("Frame", sliderRail)
	sliderDot.Size = UDim2.new(0, 12, 0, 12)
	sliderDot.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	sliderDot.AnchorPoint = Vector2.new(0.5, 0.5)
	sliderDot.Position = UDim2.new(0, 0, 0.5, 0)
	
	local dotCorner = Instance.new("UICorner", sliderDot)
	dotCorner.CornerRadius = UDim.new(1, 0)

	local valueTextBox = Instance.new("TextBox", frame)
	valueTextBox.Name = "SliderTextbox"
	valueTextBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	valueTextBox.BackgroundTransparency = 0.3
	valueTextBox.Position = UDim2.new(1, -90, 0, 5)
	valueTextBox.Size = UDim2.new(0, 80, 0, 20)
	valueTextBox.Font = Enum.Font.GothamSemibold
	valueTextBox.TextColor3 = Color3.fromRGB(225, 225, 225)
	valueTextBox.TextSize = 12
	valueTextBox.TextXAlignment = Enum.TextXAlignment.Center
	valueTextBox.ClearTextOnFocus = false
	valueTextBox.ClipsDescendants = true

	local textboxCorner = Instance.new("UICorner", valueTextBox)
	textboxCorner.CornerRadius = UDim.new(0, 5)

	local textboxStroke = Instance.new("UIStroke", valueTextBox)
	textboxStroke.Color = Color3.fromRGB(255, 0, 0)

	local dragging = false
	local currentValue = default

	local function UpdateSlider(position)
		local sizeScale = math.clamp((position - sliderRail.AbsolutePosition.X) / sliderRail.AbsoluteSize.X, 0, 1)
		currentValue = math.floor((min + ((max - min) * sizeScale)) / rounding + 0.5) * rounding
		currentValue = math.clamp(currentValue, min, max)

		sliderDot.Position = UDim2.new(sizeScale, -6, 0.5, 0)
		sliderFill.Size = UDim2.fromScale(sizeScale, 1)
		valueTextBox.Text = tostring(currentValue)

		if callback then
			callback(currentValue)
		end
	end

	local function SetValueFromTextBox(text)
		local value = tonumber(text)
		if value then
			value = math.clamp(value, min, max)
			currentValue = math.floor(value / rounding + 0.5) * rounding
			local sizeScale = (currentValue - min) / (max - min)

			sliderDot.Position = UDim2.new(sizeScale, -6, 0.5, 0)
			sliderFill.Size = UDim2.fromScale(sizeScale, 1)
			valueTextBox.Text = tostring(currentValue)

			if callback then
				callback(currentValue)
			end
		end
	end

	sliderDot.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)

	sliderDot.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	valueTextBox.FocusLost:Connect(function()
		SetValueFromTextBox(valueTextBox.Text)
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			UpdateSlider(input.Position.X)
		end
	end)

	UpdateSlider(sliderRail.AbsolutePosition.X + (sliderRail.AbsoluteSize.X * ((default - min) / (max - min))))
end

-- ===== CREATE TOGGLE (PROFESSIONAL DESIGN) =====
function UILibrary:CreateToggle(parent, text)
	local Frame = Instance.new("Frame", parent)
	Frame.Size = UDim2.new(1, -5, 0, 40)
	Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	
	local frameCorner = Instance.new("UICorner", Frame)
	frameCorner.CornerRadius = UDim.new(0, 8)

	local stroke = Instance.new("UIStroke", Frame)
	stroke.Color = Color3.fromRGB(255, 0, 0)

	local Label = Instance.new("TextLabel", Frame)
	Label.Text = text
	Label.Size = UDim2.new(0.6, 0, 1, 0)
	Label.Position = UDim2.new(0, 10, 0, 0)
	Label.BackgroundTransparency = 1
	Label.TextColor3 = Color3.new(1, 1, 1)
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 14
	Label.TextXAlignment = Enum.TextXAlignment.Left

	-- ===== PROFESSIONAL TOGGLE SLIDER =====
	local ToggleSlider = Instance.new("Frame", Frame)
	ToggleSlider.Size = UDim2.fromOffset(36, 18)
	ToggleSlider.AnchorPoint = Vector2.new(1, 0.5)
	ToggleSlider.Position = UDim2.new(1, -10, 0.5, 0)
	ToggleSlider.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	ToggleSlider.BackgroundTransparency = 1
	
	local sliderCorner = Instance.new("UICorner", ToggleSlider)
	sliderCorner.CornerRadius = UDim.new(0, 9)

	local ToggleBorder = Instance.new("UIStroke", ToggleSlider)
	ToggleBorder.Transparency = 0.5
	ToggleBorder.Color = Color3.fromRGB(255, 0, 0)

	-- Circle indicator
	local ToggleCircle = Instance.new("ImageLabel", ToggleSlider)
	ToggleCircle.AnchorPoint = Vector2.new(0, 0.5)
	ToggleCircle.Size = UDim2.fromOffset(14, 14)
	ToggleCircle.Position = UDim2.new(0, 2, 0.5, 0)
	ToggleCircle.Image = "http://www.roblox.com/asset/?id=12266946128"
	ToggleCircle.ImageTransparency = 0.5
	ToggleCircle.ImageColor3 = Color3.fromRGB(255, 0, 0)
	ToggleCircle.BackgroundTransparency = 1

	local enabled = false

	local function SetToggleValue(value)
		enabled = value
		
		local newPos = enabled and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
		local newBorderColor = enabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
		local newCircleColor = enabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
		local newTransparency = enabled and 0 or 0.5

		TweenService:Create(
			ToggleCircle,
			TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{Position = newPos}
		):Play()

		TweenService:Create(
			ToggleBorder,
			TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{Color = newBorderColor}
		):Play()

		TweenService:Create(
			ToggleCircle,
			TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ImageColor3 = newCircleColor, ImageTransparency = newTransparency}
		):Play()
	end

	Frame.MouseButton1Click:Connect(function()
		SetToggleValue(not enabled)
	end)

	return {
		Enabled = enabled,
		SetValue = SetToggleValue,
		GetValue = function() return enabled end
	}
end

-- ===== CREATE DROPDOWN =====
function UILibrary:CreateDropdown(parent, title, items, callback)
	local containerFrame = Instance.new("Frame", parent)
	containerFrame.Size = UDim2.new(1, -5, 0, 40)
	containerFrame.BackgroundTransparency = 1
	containerFrame.LayoutOrder = 0

	local frame = Instance.new("Frame", containerFrame)
	frame.Size = UDim2.new(1, 0, 0, 40)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	frame.Position = UDim2.new(0, 0, 0, 0)
	
	local frameCorner = Instance.new("UICorner", frame)
	frameCorner.CornerRadius = UDim.new(0, 8)

	local stroke = Instance.new("UIStroke", frame)
	stroke.Color = Color3.fromRGB(255, 0, 0)

	local label = Instance.new("TextLabel", frame)
	label.Size = UDim2.new(0.6, 0, 1, 0)
	label.Position = UDim2.new(0, 10, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = title
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.Gotham
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left

	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(0, 100, 0, 24)
	btn.Position = UDim2.new(1, -110, 0.5, -12)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	btn.Text = "Select"
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamSemibold
	btn.AutoButtonColor = false
	
	local btnCorner = Instance.new("UICorner", btn)
	btnCorner.CornerRadius = UDim.new(0, 6)

	local dropdown = Instance.new("Frame", containerFrame)
	dropdown.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	dropdown.Visible = false
	dropdown.Position = UDim2.new(0, 0, 0, 45)
	dropdown.Size = UDim2.new(1, 0, 0, 0)
	dropdown.ZIndex = 100
	
	local dropdownCorner = Instance.new("UICorner", dropdown)
	dropdownCorner.CornerRadius = UDim.new(0, 6)

	local layout = Instance.new("UIListLayout", dropdown)
	layout.Padding = UDim.new(0, 4)

	local confirm = Instance.new("TextButton", dropdown)
	confirm.Size = UDim2.new(1, 0, 0, 30)
	confirm.Text = "Confirm"
	confirm.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	confirm.TextColor3 = Color3.new(1, 1, 1)
	confirm.Visible = false
	confirm.Font = Enum.Font.GothamSemibold
	confirm.AutoButtonColor = false
	
	local confirmCorner = Instance.new("UICorner", confirm)
	confirmCorner.CornerRadius = UDim.new(0, 8)

	local selected
	local selectedItem

	for _, v in ipairs(items) do
		local item = Instance.new("TextButton", dropdown)
		item.Size = UDim2.new(1, 0, 0, 28)
		item.Text = v
		item.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
		item.TextColor3 = Color3.new(1, 1, 1)
		item.Font = Enum.Font.GothamSemibold
		item.AutoButtonColor = false
		
		local itemCorner = Instance.new("UICorner", item)
		itemCorner.CornerRadius = UDim.new(0, 6)

		item.MouseButton1Click:Connect(function()
			selected = v
			btn.Text = v
			confirm.Visible = true

			if selectedItem and selectedItem ~= item then
				TweenService:Create(selectedItem, TweenInfo.new(0.2), {
					BackgroundColor3 = Color3.fromRGB(15, 15, 15)
				}):Play()
			end

			selectedItem = item
			TweenService:Create(item, TweenInfo.new(0.2), {
				BackgroundColor3 = Color3.fromRGB(0, 120, 255)
			}):Play()
		end)
	end

	local isOpen = false

	btn.MouseButton1Click:Connect(function()
		isOpen = not isOpen

		local size = frame.AbsoluteSize
		local targetHeight = (#items * 28) + 35

		if isOpen then
			dropdown.Visible = true
			dropdown.Size = UDim2.new(0, size.X, 0, 0)
			containerFrame.Size = UDim2.new(1, -5, 0, 40 + targetHeight + 5)

			TweenService:Create(dropdown, TweenInfo.new(0.25), {
				Size = UDim2.new(1, 0, 0, targetHeight)
			}):Play()
		else
			local tween = TweenService:Create(dropdown, TweenInfo.new(0.2), {
				Size = UDim2.new(1, 0, 0, 0)
			})
			tween:Play()
			tween.Completed:Connect(function()
				dropdown.Visible = false
				confirm.Visible = false
				containerFrame.Size = UDim2.new(1, -5, 0, 40)
			end)
		end
	end)

	confirm.MouseButton1Click:Connect(function()
		isOpen = false

		local tween = TweenService:Create(dropdown, TweenInfo.new(0.2), {
			Size = UDim2.new(1, 0, 0, 0)
		})
		tween:Play()

		tween.Completed:Connect(function()
			dropdown.Visible = false
			confirm.Visible = false
			containerFrame.Size = UDim2.new(1, -5, 0, 40)
		end)

		if callback then
			callback(selected)
		end
	end)
end

