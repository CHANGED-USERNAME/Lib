--[[
	UILibrary v2.0
	Professional UI Library with Icon Support & Reload Prevention
	Created for Roblox
]]

local UILibrary = {}
UILibrary.__index = UILibrary

-- ===== SERVICES =====
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- ===== RELOAD PREVENTION SYSTEM =====
if _G.UILibraryLoaded then
	warn("[UILibrary] Already loaded! Reloading UI...")
	if _G.UILibraryInstance then
		_G.UILibraryInstance:Destroy()
	end
end

_G.UILibraryLoaded = true

-- ===== MAIN LIBRARY CREATION =====
function UILibrary.new(LibraryName)
	local self = setmetatable({}, UILibrary)
	
	self.Name = LibraryName or "UILibrary"
	self.TabsList = {}
	self.PagesList = {}
	self.Options = {}
	
	-- ===== MAIN GUI =====
	self.ScreenGui = Instance.new("ScreenGui")
	self.ScreenGui.Parent = game.CoreGui
	self.ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	self.ScreenGui.Name = self.Name

	-- ===== MAIN FRAME =====
	self.Main = Instance.new("Frame", self.ScreenGui)
	self.Main.Size = UDim2.new(0, 460, 0, 320)
	self.Main.Position = UDim2.new(0.5, -230, 0.5, -160)
	self.Main.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	self.Main.Name = "Main"
	
	local mainCorner = Instance.new("UICorner", self.Main)
	mainCorner.CornerRadius = UDim.new(0, 8)
	
	local mainStroke = Instance.new("UIStroke", self.Main)
	mainStroke.Color = Color3.fromRGB(255, 0, 0)
	mainStroke.Thickness = 2

	-- ===== TITLE BAR =====
	self.TitleBar = Instance.new("Frame", self.Main)
	self.TitleBar.Size = UDim2.new(1, 0, 0, 35)
	self.TitleBar.BackgroundTransparency = 1
	self.TitleBar.Name = "TitleBar"

	local Title = Instance.new("TextLabel", self.TitleBar)
	Title.Size = UDim2.new(1, 0, 1, 0)
	Title.BackgroundTransparency = 1
	Title.Text = self.Name
	Title.TextColor3 = Color3.fromRGB(255, 0, 0)
	Title.Font = Enum.Font.GothamBold
	Title.TextSize = 16

	-- ===== DRAG FUNCTIONALITY =====
	local dragging, dragStart, startPos

	self.TitleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = self.Main.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			self.Main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	-- ===== TABS SECTION =====
	self.Tabs = Instance.new("ScrollingFrame", self.Main)
	self.Tabs.Size = UDim2.new(0, 120, 1, -45)
	self.Tabs.Position = UDim2.new(0, 5, 0, 40)
	self.Tabs.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	self.Tabs.ScrollBarThickness = 3
	self.Tabs.Name = "Tabs"
	
	local tabsCorner = Instance.new("UICorner", self.Tabs)
	tabsCorner.CornerRadius = UDim.new(0, 6)

	local TabLayout = Instance.new("UIListLayout", self.Tabs)
	TabLayout.Padding = UDim.new(0, 5)

	TabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		self.Tabs.CanvasSize = UDim2.new(0, 0, 0, TabLayout.AbsoluteContentSize.Y + 10)
	end)

	self.Pages = Instance.new("Folder", self.Main)
	self.Pages.Name = "Pages"

	-- ===== CLEANUP ON GAME LEAVE =====
	game.Players.LocalPlayer.AncestryChanged:Connect(function(child, parent)
		if parent == nil then
			_G.UILibraryLoaded = false
			_G.UILibraryInstance = nil
		end
	end)

	_G.UILibraryInstance = self
	return self
end

-- ===== CREATE PAGE =====
function UILibrary:CreatePage(name)
	local Page = Instance.new("ScrollingFrame", self.Pages)
	Page.Name = name
	Page.Size = UDim2.new(1, -135, 1, -45)
	Page.Position = UDim2.new(0, 130, 0, 40)
	Page.BackgroundTransparency = 1
	Page.Visible = false
	Page.ScrollBarThickness = 3

	local Layout = Instance.new("UIListLayout", Page)
	Layout.Padding = UDim.new(0, 6)

	Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		Page.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10)
	end)

	return Page
end

-- ===== CREATE TAB (WITH ICON SUPPORT) =====
function UILibrary:CreateTab(name, iconId)
	local Tab = Instance.new("TextButton", self.Tabs)
	Tab.Size = UDim2.new(1, -10, 0, 35)
	Tab.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	Tab.TextColor3 = Color3.new(1, 1, 1)
	Tab.Font = Enum.Font.GothamBold
	Tab.TextSize = 11
	Tab.AutoButtonColor = false
	Tab.Name = name
	
	local tabCorner = Instance.new("UICorner", Tab)
	tabCorner.CornerRadius = UDim.new(0, 6)

	-- Add icon if provided
	if iconId then
		local icon = Instance.new("ImageLabel", Tab)
		icon.Size = UDim2.fromOffset(16, 16)
		icon.Position = UDim2.new(0, 8, 0.5, -8)
		icon.Image = iconId
		icon.BackgroundTransparency = 1
		icon.ImageColor3 = Color3.fromRGB(150, 150, 150)
		
		Tab.Text = name
		Tab.TextXAlignment = Enum.TextXAlignment.Center
	else
		Tab.Text = name
	end

	local Page = self:CreatePage(name)

	self.TabsList[name] = Tab
	self.PagesList[name] = Page

	Tab.MouseButton1Click:Connect(function()
		for _, p in pairs(self.PagesList) do
			p.Visible = false
		end
		for _, t in pairs(self.TabsList) do
			t.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
			local iconChild = t:FindFirstChildOfClass("ImageLabel")
			if iconChild then
				iconChild.ImageColor3 = Color3.fromRGB(150, 150, 150)
			end
		end
		Page.Visible = true
		Tab.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
		local iconChild = Tab:FindFirstChildOfClass("ImageLabel")
		if iconChild then
			iconChild.ImageColor3 = Color3.fromRGB(255, 255, 255)
		end
	end)

	-- Hover effect
	Tab.MouseEnter:Connect(function()
		if Tab.BackgroundColor3 ~= Color3.fromRGB(255, 0, 0) then
			TweenService:Create(Tab, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 35)}):Play()
		end
	end)

	Tab.MouseLeave:Connect(function()
		if Tab.BackgroundColor3 ~= Color3.fromRGB(255, 0, 0) then
			TweenService:Create(Tab, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 25)}):Play()
		end
	end)

	return Page
end

